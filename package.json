{
  "name": "days_of_year",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && vk-miniapps-deploy",
    "check": "npm run lint && npm run build && npm run test:coverage",
    "test:timezone": "TZ=America/New_York vitest run src/__tests__/utils.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vkontakte/vk-bridge": "^3.0.2",
    "@vkontakte/vkui": "^8.4.1",
    "html2canvas": "^1.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vkontakte/vk-miniapps-deploy": "^1.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
